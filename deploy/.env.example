# Copy to deploy/.env and fill in. deploy/.env is git-ignored — never commit real secrets.
#
#   cp deploy/.env.example deploy/.env
#
# Generate a strong JWT secret with:
#   openssl rand -base64 48

# --- Required -----------------------------------------------------------------------------------

# MySQL root password. Also used as the application's database password.
MYSQL_ROOT_PASSWORD=

# HS256 signing key for the application's JWTs. Must be at least 32 characters.
# Changing it invalidates every existing session.
TEXT2SQL_JWT_SECRET=

# --- Optional -----------------------------------------------------------------------------------

# Application database name.
APP_DB_NAME=text2sql

# DashScope API key, needed only for the LLM-backed text-to-SQL features. Leave empty to run the
# demo without a model (registration, login and conversation management still work).
DASHSCOPE_API_KEY=
