# Copy to deploy/.env and fill in. deploy/.env is git-ignored — never commit real secrets.
#
#   cp deploy/.env.example deploy/.env
#
# Generate a strong JWT secret with:
#   openssl rand -base64 48

# --- Required -----------------------------------------------------------------------------------

# MySQL root password. This is the password you will type when connecting to the database, so pick
# something you are comfortable typing.
MYSQL_ROOT_PASSWORD=

# HS256 signing key for the application's JWTs. Must be at least 32 characters. Nothing ever types
# this by hand, so keep it random. Changing it invalidates every existing session, and a guessable
# value lets anyone forge an admin token.
TEXT2SQL_JWT_SECRET=

# --- Optional -----------------------------------------------------------------------------------

# Application database name.
APP_DB_NAME=text2sql

# DashScope API key, needed only for the LLM-backed text-to-SQL features. Leave empty to run the
# demo without a model (registration, login and conversation management still work).
DASHSCOPE_API_KEY=

# --- Container images ---------------------------------------------------------------------------
# This deployment runs in mainland China, where registry-1.docker.io and auth.docker.io are blocked,
# so the images below are pulled from Huawei Cloud SWR (docker.aityp.com publishes the mapping).
# Delete a line to fall back to the Docker Hub reference in the comment above it.
#
# Note the inconsistency in the mirror's layout — this is what the registry actually serves:
#   maven            has NO library/ prefix
#   eclipse-temurin  REQUIRES the library/ prefix
#
# Docker Hub: mysql:8.4
MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/mysql:8.4
# Docker Hub: grafana/otel-lgtm:0.22.0  (the mirror has no "latest" tag)
OTEL_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/otel-lgtm:0.22.0
# Docker Hub: maven:3.9.16-eclipse-temurin-25-noble
MAVEN_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/maven:3.9.16-eclipse-temurin-25-noble
# Docker Hub: eclipse-temurin:25-jre-alpine
JRE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/eclipse-temurin:25-jre-alpine
# Docker Hub: node:22-alpine
NODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:22-alpine
# Docker Hub: nginx:alpine
NGINX_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/nginx:alpine
